# SD Image Sorter Configuration
# Copy this file to .env and customize as needed.
# All settings can also be set via environment variables directly.

# =============================================================================
# Model Download Mirror
# =============================================================================

# HuggingFace endpoint override for users who cannot access huggingface.co.
# Uncomment and set to use the hf-mirror proxy for model downloads.
# HF_ENDPOINT=https://hf-mirror.com

# Persisted mirror choice (also settable via the in-app Models view).
# The app stores this in CONFIG_DIR/download-mirror.json. Valid values:
# auto | hf-mirror | modelscope.

# =============================================================================
# Update Channel (Manual Check)
# =============================================================================

# The app never auto-updates. It only checks when the user clicks the update button.
# Put this .env file next to run.bat / run.sh so the whole package stays self-contained.

# Latest-release API endpoint. Must return GitHub-style release JSON.
# Users behind restrictive networks can point this to a mirror or proxy they can reach.
# Default: https://api.github.com/repos/Rinne414/sd-image-sorter/releases/latest
# SD_IMAGE_SORTER_UPDATE_API_URL=https://api.github.com/repos/Rinne414/sd-image-sorter/releases/latest

# Release page used when the patch is unavailable or manual download is needed.
# Default: https://github.com/Rinne414/sd-image-sorter/releases/latest
# SD_IMAGE_SORTER_UPDATE_WEB_URL=https://github.com/Rinne414/sd-image-sorter/releases/latest

# Optional download proxy prefix. This value is prepended verbatim to every asset URL.
# Example 1: https://ghfast.top/
# Example 2: https://mirror.example/proxy?url=
# SD_IMAGE_SORTER_UPDATE_DOWNLOAD_URL_PREFIX=

# =============================================================================
# Package-Local Directories
# =============================================================================

# Package-local data directory.
# Default: ./data (inside the app package)
# SD_IMAGE_SORTER_DATA_DIR=/path/to/sd-image-sorter/data

# Package-local temp directory used for uploads and update staging.
# Default: ./data/tmp
# SD_IMAGE_SORTER_TMP_DIR=/path/to/sd-image-sorter/data/tmp

# Package-local update working directory.
# Default: ./update
# SD_IMAGE_SORTER_UPDATE_DIR=/path/to/sd-image-sorter/update

# Package-local thumbnail cache.
# Default: ./data/thumbnails
# SD_IMAGE_SORTER_THUMBNAIL_DIR=/path/to/sd-image-sorter/data/thumbnails

# =============================================================================
# Database Configuration
# =============================================================================

# Path to the SQLite database file
# Default: data/images.db (relative to package root)
# SD_IMAGE_SORTER_DB_PATH=/path/to/custom/images.db

# Path to the favorites folder
# Default: data/favorites
# SD_IMAGE_SORTER_FAVORITES_PATH=/path/to/favorites

# =============================================================================
# Server Configuration
# =============================================================================

# Server host address
# Default: 127.0.0.1 (localhost only, recommended for security)
# Use 0.0.0.0 to allow external connections (not recommended)
SD_IMAGE_SORTER_HOST=127.0.0.1

# Server port
# Default: 8487
SD_IMAGE_SORTER_PORT=8487

# Lightweight API rate limit
# The app already rejects non-local callers, so loopback rate limiting is off by default
# to avoid false 429s during heavy local workflows.
# SD_IMAGE_SORTER_ENABLE_RATE_LIMIT=true
# SD_IMAGE_SORTER_RATE_LIMIT_WINDOW_SECONDS=60
# SD_IMAGE_SORTER_RATE_LIMIT_MAX_REQUESTS=1000
# SD_IMAGE_SORTER_RATE_LIMIT_LOOPBACK=false

# =============================================================================
# Model Directories
# =============================================================================

# WD14 Tagger model storage directory
# Models will be downloaded here on first use
# Default: data/models/wd14-tagger (relative to package root)
# SD_IMAGE_SORTER_WD14_MODEL_DIR=/path/to/models/wd14-tagger

# YOLO censor model directory
# Default: data/models/yolo (relative to package root)
# SD_IMAGE_SORTER_YOLO_MODEL_DIR=/path/to/models/yolo

# SAM3 model storage directory
# Default: data/models/sam3
# SD_IMAGE_SORTER_SAM3_MODEL_DIR=/path/to/models/sam3

# Artist (Kaloscope + LSNet) model directory
# Default: data/models/artist
# SD_IMAGE_SORTER_ARTIST_MODEL_DIR=/path/to/models/artist

# Default cache directory (fallback for models)
# Default: data/cache (relative to package root)
# SD_IMAGE_SORTER_CACHE_DIR=/path/to/cache

# =============================================================================
# WD14 Tagger Configuration
# =============================================================================

# Default tagger model
# Options: wd-eva02-large-tagger-v3 (best quality), wd-swinv2-tagger-v3,
#          wd-convnext-tagger-v3, wd-vit-tagger-v3, wd-vit-large-tagger-v3
# Default: wd-swinv2-tagger-v3
SD_IMAGE_SORTER_DEFAULT_TAGGER_MODEL=wd-swinv2-tagger-v3

# Confidence threshold for general tags (0.0 - 1.0)
# Lower = more tags, Higher = fewer but more accurate tags
# Default: 0.35
SD_IMAGE_SORTER_TAGGER_GENERAL_THRESHOLD=0.35

# Confidence threshold for character tags (0.0 - 1.0)
# Character tags are typically harder to detect, hence higher threshold
# Default: 0.85
SD_IMAGE_SORTER_TAGGER_CHARACTER_THRESHOLD=0.85

# Enable GPU acceleration for tagging
# Set to "false" to force CPU-only mode (slower but more compatible)
# Default: true
SD_IMAGE_SORTER_TAGGER_USE_GPU=true

# =============================================================================
# Censor Configuration
# =============================================================================

# Default detection confidence threshold (0.0 - 1.0)
# Lower = more detections (more false positives)
# Higher = fewer detections (may miss some)
# Default: 0.60
SD_IMAGE_SORTER_CENSOR_CONFIDENCE=0.60

# IOU threshold for Non-Maximum Suppression (0.0 - 1.0)
# Controls overlapping box merging
# Default: 0.45
SD_IMAGE_SORTER_CENSOR_IOU_THRESHOLD=0.45

# Default mosaic block size (pixels)
# Larger = more pixelated, Smaller = finer mosaic
# Default: 16
SD_IMAGE_SORTER_CENSOR_BLOCK_SIZE=16

# Default blur radius (pixels)
# Larger = more blurred
# Default: 20
SD_IMAGE_SORTER_CENSOR_BLUR_RADIUS=20

# =============================================================================
# Similarity/CLIP Configuration
# =============================================================================

# CLIP embedding model name
# Default: Qdrant/clip-ViT-B-32-vision
# SD_IMAGE_SORTER_CLIP_MODEL=Qdrant/clip-ViT-B-32-vision

# Default number of similar images to return
# Default: 20
SD_IMAGE_SORTER_SIMILARITY_LIMIT=20

# Default similarity threshold (0.0 - 1.0)
# Higher = only very similar images
# Default: 0.5
SD_IMAGE_SORTER_SIMILARITY_THRESHOLD=0.5

# Duplicate detection threshold (0.0 - 1.0)
# Higher = stricter duplicate matching
# Default: 0.95
SD_IMAGE_SORTER_DUPLICATE_THRESHOLD=0.95

# =============================================================================
# Batch Processing
# =============================================================================

# Number of images to process per batch during tagging
# Lower = less memory usage, slower
# Higher = more memory usage, faster
# Default: 10
SD_IMAGE_SORTER_TAGGER_BATCH_SIZE=10

# Number of images to process per batch during embedding
# Default: 10
SD_IMAGE_SORTER_EMBEDDING_BATCH_SIZE=10

# Chunk size for duplicate detection matrix operations
# Lower = less memory, more iterations
# Higher = more memory, fewer iterations
# Default: 500
SD_IMAGE_SORTER_DUPLICATE_CHUNK_SIZE=500

# =============================================================================
# Path Validation (Security)
# =============================================================================

# Maximum path depth (number of directory levels)
# Prevents directory traversal attacks
# Default: 20
SD_IMAGE_SORTER_MAX_PATH_DEPTH=20

# Maximum path length (characters)
# Windows default: 260, Linux/macOS default: 4096
# SD_IMAGE_SORTER_MAX_PATH_LENGTH=260

# Maximum filename length for sanitization
# Default: 200
SD_IMAGE_SORTER_MAX_FILENAME_LENGTH=200

# =============================================================================
# Gallery/UI Defaults
# =============================================================================

# Default number of images per page in gallery
# Default: 100
SD_IMAGE_SORTER_GALLERY_LIMIT=100

# Maximum allowed gallery limit
# Set to prevent memory issues with huge libraries
# Default: 999999
# SD_IMAGE_SORTER_GALLERY_MAX_LIMIT=999999

# =============================================================================
# Model Download Tuning (added in v3.1)
# =============================================================================

# Optional pacing delay (milliseconds) between 1MB chunks during model downloads.
# Set this if your network rate-limits aggressive single-stream HTTP, or to
# yield CPU during huge model fetches.
# Default: 0 (no delay)
# SD_IMAGE_SORTER_DOWNLOAD_CHUNK_DELAY_MS=0

# Override LSNet runtime archive URL (artist identification).
# Default: GitHub release ZIP pinned by ARTIST_LSNET_RUNTIME_REVISION in code.
# SD_IMAGE_SORTER_ARTIST_RUNTIME_ZIP_URL=

# Override the Kaloscope checkpoint URLs. Useful when the user picks the
# "modelscope" mirror (Kaloscope is hosted on HuggingFace, so a custom
# mirror URL is required for native ModelScope routing).
# SD_IMAGE_SORTER_ARTIST_CHECKPOINT_URL=
# SD_IMAGE_SORTER_ARTIST_CLASS_MAPPING_URL=

# Skip auto-bootstrap copy from legacy ./models/artist/ (Windows portable layout).
# Set to "1" to disable. Default: enabled.
# SD_IMAGE_SORTER_DISABLE_LEGACY_MODEL_COPY=

# =============================================================================
# SAM3 / PyTorch Runtime Repair (Windows portable)
# =============================================================================

# Alternate base URL for the SAM3 checkpoint bundle download. Every file in
# the transformers checkpoint (model.safetensors, config.json, tokenizer files)
# is fetched as <base>/<filename>.
# Default: ModelScope mirror of facebook/sam3.
# SD_IMAGE_SORTER_SAM3_BASE_URL=

# Skip the Windows-only PyTorch CUDA wheel auto-installer.
# Set to "1" to keep the CPU-only Torch baseline (e.g. on AMD/Intel GPUs).
# Default: unset (CUDA repair runs on NVIDIA hardware).
# SD_IMAGE_SORTER_SKIP_TORCH_REPAIR=

# Skip the SAM3 Python runtime package install (sam3, einops, hydra-core, ...).
# Default: unset (SAM3 runtime auto-installed on first launch).
# SD_IMAGE_SORTER_SKIP_SAM3_RUNTIME_REPAIR=

# Maximum seconds to wait for repair_torch_runtime.py to finish.
# Default: 3600
# SD_IMAGE_SORTER_TORCH_REPAIR_TIMEOUT=3600

# Override the PyTorch CUDA wheel index URL used by repair_torch_runtime.py.
# Default: chosen automatically by detected nvidia-smi CUDA version
# (cu128 / cu126 / cu124 / cu121 fallback ladder).
# SD_IMAGE_SORTER_TORCH_CUDA_INDEX_URL=

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
SD_IMAGE_SORTER_LOG_LEVEL=INFO
