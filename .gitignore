# SD Image Sorter - .gitignore

# Python virtual environment
backend/venv/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables (user-specific configuration)
.env
.env.local
.env.*.local

# Requirements hash (auto-generated by launcher scripts)
backend/.requirements_hash

# Database (contains user-specific file paths)
backend/images.db
*.db

# ALL model files (auto-downloaded on first use, do NOT commit binaries)
models/wd14-tagger/
models/artist/
models/clip/
models/sam3/
models/nudenet/
models/aesthetic/
models/yolo/*.onnx
models/yolo/*.pt

# Embedded Python (generated by release script, not source)
python/
run-portable.bat
data/
update/

# Internal dev files (not for public repo)
AGENTS.md
CLAUDE.md
THIRD_PARTY_MODELS.md
SECURITY.md
backend/lora_debug.txt
example/
models/nudenet/

# Test images and personal folders (may contain personal images)
testimage/
backend/test-path/
backend/favorites/

# Output directories - ignore anywhere in repo (prevent accidental uploads!)
**/outputs/
**/censored_output/
outputs/
censored_output/

# Prevent any stray images in backend from being committed
backend/*.png
backend/*.jpg
backend/*.jpeg
backend/*.webp

# Debug and log files
*.log
backend/lora_debug.txt

# IDE files
.vscode/
.vs/
.idea/
*.swp
*.swo
.gemini/

# OS files
.DS_Store
Thumbs.db

# Mypy output files
mypy_*.txt

# Coverage and cache
.coverage
.coverage.*
coverage.xml
htmlcov/
backend/.coverage
backend/.coverage.*
backend/coverage.xml
backend/htmlcov/
backend/.mypy_cache/

# Thumbnail cache (runtime generated)
backend/thumbnails/
backend/sort_session.json

# Temp test directories
.tools/
.tmp/
.tmp_*/
.playwright-tmp-results/
.playwright-mcp/
test-results/
artifacts/
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/.pw-out/

# Loose test screenshots that sometimes get dropped at the repo root by
# ad-hoc playwright runs. Keep them out of git AND the release builder.
# Real product screenshots live under docs/screenshots/.
/e2e-*.png
/e2e-*.jpg
/e2e-*.jpeg
/e2e-*.webp
/playwright-*.png
/playwright-*.jpg
/playwright-*.jpeg
/playwright-*.webp
/screenshot-*.png
/screenshot-*.jpg
/test-*.png
/test-*.jpg

# Reference files (binaries, external tools)
reference/

# Internal planning docs
.plans/

# Claude Code internal
.claude/
.worktrees/

# Kiro CLI state. The whole directory is ignored further down, matching how
# AGENTS.md / CLAUDE.md are treated: agent instructions stay local and out of
# the public repo. (An earlier comment here claimed .kiro/steering/ was
# committed on purpose, but it never was.)
.kiro/agents/
.kiro/sessions/
.kiro/cache/

# Local dev screenshots / probe artifacts dropped at repo root
/batch_export_modal.png
/color_backfill_banner.png
/mass_tag_confirm.png
/mass_tag_editor.png
/gallery-*.png
/censor-*.png
/reader-*.png
/sort-*.png
/nav-*.png
/tagger-*.png
/guide-*.png
/real-*.png
/verify-*.png
/full-*.png
/audit-*.png
/audit-*.jpeg
/smoke-*.png
/smoke-*.jpeg
/gallery-snapshot.md
/nav-snapshot.md

# Local Kiro / Claude Code chat session exports (kiro-cli `/chat save` and
# Claude Code's `.claude/...txt` continuation dumps end up here when users
# save them at the repo root). Never commit, package, or push these.
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
/*-session-export*.json
/kiro-session-*.json
/chat-session-*.json
/.claude/*.txt

# Node.js (E2E testing infrastructure, root level)
node_modules/
package.json
package-lock.json

# ToriiGate model files (auto-downloaded, very large)
models/toriigate/

# Playwright persistent state
tests/e2e/storage/

# Dev-only scripts (not for distribution)
backend/fix_db_ratings.py
backend/test_censor_logic.py
backend/test_functionality.py
backend/test_images_thumbnail.py
backend/test_metadata_parser_params.py
backend/verify_sorting.py

# Internal docs (generated, not for public repo)
# docs/API.md is versioned because API contract tests validate it.
docs/DELETION_LOG.md
docs/IMPROVEMENT_PLAN.md
docs/SECURITY_ARCHITECTURE.md
docs/architecture.md

# Internal scratch / audit prompts (not for public repo)
v3_audit_prompt.md
v3-2-1.md
v[0-9]*-[0-9]*-[0-9]*.md

# Windows temp files
nul

# Optional local YOLO compatibility downloads (packaged via release assets, not source control)
models/yolo/civitai/
models/yolo/yolo26s-seg.onnx
models/yolo/yolo26s-seg.pt
models/yolo/yolov8s-seg.onnx
models/yolo/yolov8s-seg.pt
# Kiro CLI local state
.kiro/

# Aurora redesign handoff bundle (local design reference, not product code)
SD image sorter redesign.zip
design_handoff_extract/

# SQLite sidecar files (the .db itself is already ignored above)
*.db-shm
*.db-wal

# Local scratch dirs that the earlier rules missed. These have all shown up at
# the repo root in practice and are big enough that one accidental `git add .`
# would push hundreds of MB to the public repo.
.k/
.test-tmp/
.pytest-goal-tmp/
.pytest-runtime-secret-*/

# Personal test images dropped at the repo root
metadata missing/

# Agent-generated audit/handoff reports. The release builder already skips
# *-REPORT.md; these rules stop them from reaching git in the first place.
claude-*.md
HANDOFF-*.md
qa-sweep-*.md
*-REPORT.md

# The rules above key off a prefix; root-level scratch audits have also landed
# with an "-audit" SUFFIX and no claude- prefix (the 2026-08 cleanup removed
# claude-code-sd-image-sorter-tagger-audit.md, and v3_audit_prompt.md above
# needed its own line for the same reason). Root-anchored so real docs under
# docs/ are unaffected.
/*-audit.md
/*-AUDIT.md
